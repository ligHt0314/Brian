APP_ENV=development
DEMO_MODE=true
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OPERATOR_RESET_TOKEN=
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6389
FALKORDB_PASSWORD=
